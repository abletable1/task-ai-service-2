# Copy to .env. Paste Authorization Key WITHOUT the 'Basic ' prefix.
APP_ENV=dev
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# Optional PEM bundle with trusted additional CA certificates. TLS verification is always on.
GIGACHAT_CA_BUNDLE=
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=15
LLM_TOTAL_TIMEOUT_SECONDS=40
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=256
MAX_INPUT_CHARS=20000
MAX_SUMMARY_CHARS=2000
HOST=127.0.0.1
PORT=8000
